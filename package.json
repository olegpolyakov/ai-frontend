{
    "name": "@olegpolyakov/ai-frontend",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite dev",
        "compile": "tsc --noEmit",
        "lint": "eslint ./src ./demo",
        "preversion": "rm -f package-lock.json && npm install --workspaces=false && git add package-lock.json",
        "postversion": "git tag $npm_package_version && git push origin $npm_package_version && rm -rf node_modules"
    },
    "dependencies": {
        "@olegpolyakov/frontend": "^0.7.0",
        "@olegpolyakov/ui": "^0.11.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@typescript-eslint/eslint-plugin": "^8.53.1",
        "@typescript-eslint/parser": "^8.53.1"
    }
}